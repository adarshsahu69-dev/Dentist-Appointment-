# ------------------------------------------------------------------
# DentalCare environment configuration. Copy to .env.local and fill in.
# NEVER commit .env.local or expose service-role keys to the client.
# ------------------------------------------------------------------

# App
APP_NAME=DentalCare
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (leave empty to run in DEMO MODE with mock data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose via NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Secret used to sign demo-mode session cookies (any long random string).
AUTH_SECRET=replace-with-a-long-random-string

# --- Email notifications (optional; demo mode logs + in-app notifications) ---
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=appointments@dentalcare.example

# --- Google Maps (browser key; restrict by HTTP referrer in Google Cloud) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Cron / reminders endpoint protection ---
CRON_SECRET=replace-with-a-long-random-string
